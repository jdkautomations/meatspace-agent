{
  "name": "meatspace-agent",
  "version": "0.1.0",
  "description": "MCP-native AI agent that orchestrates real-world tasks via RentAHuman.ai — starting with rental property condition verification in Sacramento 95815",
  "main": "dist/mcp/server.js",
  "bin": {
    "meatspace-agent": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/mcp/server.js",
    "dev": "ts-node src/mcp/server.ts",
    "test": "jest --testPathPattern='tests/'",
    "test:watch": "jest --watch",
    "lint": "eslint src/ tests/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "example": "ts-node examples/property-inspection.ts"
  },
  "keywords": [
    "mcp",
    "ai-agent",
    "rentahuman",
    "property-inspection",
    "real-estate",
    "sacramento",
    "meatspace"
  ],
  "author": "jdkautomations",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
