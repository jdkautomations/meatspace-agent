# RentAHuman.ai API
RENTAHUMAN_API_KEY=rah_your_api_key_here
RENTAHUMAN_MCP_URL=https://rentahuman.ai/api/mcp

# Agent Configuration
AGENT_ID=your_agent_identity
AGENT_NAME=MeatspaceAgent-95815
DEFAULT_LOCATION=sacramento-95815

# LLM Provider (Nebius or similar)
LLM_PROVIDER=nebius
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o

# Maps / Geofencing
GOOGLE_MAPS_API_KEY=your_google_maps_key
MAPS_BASE_URL=https://maps.googleapis.com

# Payments / Payouts
PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=sk_test_your_stripe_key

# Storage
STORAGE_PROVIDER=s3
S3_BUCKET=meatspace-agent-evidence
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-west-2

# SMS / Notifications
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1your_number

# Environment
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug
